{
  "name": "pixel-perfect-repository",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:locked": "node --test tests/sprint-01/*.test.mjs test/harness/runtime/capture-observe.test.mjs",
    "test:locked:ci": "node --test tests/sprint-01/grd-01-twelve-cells.test.mjs tests/sprint-01/grd-02-four-grades.test.mjs tests/sprint-01/grd-03-evidence.test.mjs tests/sprint-01/grd-03b-mapping-cli.test.mjs tests/sprint-01/grd-04-named-path.test.mjs tests/sprint-01/grd-05-clean-twin.test.mjs tests/sprint-01/grd-06-missing-key.test.mjs tests/sprint-01/jrn-planted-and-twin.test.mjs tests/sprint-01/run-02-hand.characterization.test.mjs tests/sprint-01/t14-capture-requiredness.test.mjs tests/sprint-01/t15-hosted-controls.test.mjs tests/sprint-01/t16-claude-code-grades.test.mjs tests/sprint-01/t19-smoke-step-records.test.mjs test/harness/runtime/capture-observe.test.mjs",
    "verify": "node scripts/release.mjs verify",
    "validate": "node scripts/build-adapters.mjs --check && node scripts/validate-plugin.mjs && node scripts/validate-skills.mjs && node scripts/check-runtime-paths.mjs && node scripts/validate-workflows.mjs && node scripts/validate-contracts.mjs && node scripts/validate-package.mjs",
    "ci": "pnpm verify && pnpm validate && pnpm test"
  },
  "dependencies": {
    "@google/design.md": "0.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4"
  }
}
