{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"sandbox": "storybook dev -p 6006",
		"sandbox:capture": "storybook build --quiet >/dev/null && node scripts/sandbox-capture.mjs",
		"export:social": "node scripts/export-social-card.mjs",
		"verify:landing": "node scripts/verify-landing.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/anybody": "^5.3.0",
		"@fontsource-variable/libre-franklin": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/sveltekit": "^10.6.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"playwright-core": "^1.63.0",
		"storybook": "^10.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
