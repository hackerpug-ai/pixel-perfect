unded-lg`\u001b[76G|\r\r\n\u001b[6G|\u001b[8Gprofessional\u001b[21G|\u001b[23GSlate/zinc\u001b[34Gneutrals,\u001b[44Gstandard\u001b[53Gspacing,\u001b[62G`rounded-md`\u001b[75G|\r\r\n\u001b[6G|\u001b[8Gplayful\u001b[16G|\u001b[18GMulti-hue\u001b[28Gpalette,\u001b[37Gvaried\u001b[44Gspacing,\u001b[53G`rounded-full`\u001b[68Gon\u001b[71Gaccents\u001b[79G|\r\r\n\u001b[6G|\u001b[8Ghigh-contrast\u001b[22G|\u001b[24GLight\u001b[30Gbg\u001b[33G+\u001b[35Gdark\u001b[40Gtext\u001b[45Gmaximized,\u001b[56Gthick\u001b[62Gborders,\u001b[71Ghigh\u001b[76Gsaturation\u001b[87G|\r\r\n\r\r\n\u001b[6G###\u001b[10GCSS\u001b[14GCustom\u001b[21GProperties\u001b[32GBridge\r\r\n\u001b[6GFor\u001b[10Ginterop\u001b[18Gwith\u001b[23Gcomponent\u001b[33Glibraries\u001b[43G(shadcn,\u001b[52Getc.),\u001b[59Gexport\u001b[66Gtheme\u001b[72Gvalues\u001b[79Gas\u001b[82GCSS\u001b[86Gcustom\r\r\n\u001b[6Gproperties:\r\r\n\r\r\n\u001b[6G```css\r\r\n\u001b[6G@theme\u001b[13G{\r\r\n\u001b[8G--color-primary:\u001b[25G/*\u001b[28Gvalue\u001b[34G*/;\r\r\n\u001b[8G--color-secondary:\u001b[27G/*\u001b[30Gvalue\u001b[36G*/;\r\r\n\u001b[8G--color-accent:\u001b[24G/*\u001b[27Gvalue\u001b[33G*/;\r\r\n\u001b[8G--radius-default:\u001b[26G/*\u001b[29Gvalue\u001b[35G*/;\r\r\n\u001b[6G}\r\r\n\u001b[6G```\r\r\n\r\r\n\u001b[6G##\u001b[9GVerify\r\r\n\r\r\n\u001b[6G###\u001b[10GComponent\u001b[20GLevel\r\r\n\u001b[6G-\u001b[8GComponent\u001b[18Guses\u001b[23GTailwind\u001b[32Gutility\u001b[40Gclasses\u001b[48G(not\u001b[53Ginline\u001b[60Gstyles\u001b[67Gor\u001b[70Graw\u001b[74GCSS)\r\r\n\u001b[6G-\u001b[8GColors\u001b[15Greference\u001b[25Gtheme\u001b[31Gtokens\u001b[38G(`text-primary`,\u001b[55G`bg-secondary`)\u001b[71Gnot\u001b[75Garbitrary\u001b[85Gvalues\r\r\n\u001b[6G(`text-[#ff0000]`)\r\r\n\u001b[6G-\u001b[8GSpacing\u001b[16Guses\u001b[21GTailwind\u001b[30Gscale\u001b[36G(`p-4`,\u001b[44G`gap-6`)\u001b[53Gnot\u001b[57Garbitrary\u001b[67Gvalues\r\r\n\u001b[6G-\u001b[8GResponsive\u001b[19Gvariants\u001b[28Gare\u001b[32Gapplied\u001b[40Gwhere\u001b[46Gneeded\u001b[53G(`sm:`,\u001b[61G`md:`,\u001b[68G`lg:`)\r\r\n\u001b[6G-\u001b[8GDark\u001b[13Gmode\u001b[18Gvariants\u001b[27Gpresent\u001b[35Gif\u001b[38Gproject\u001b[46Gsupports\u001b[55Gdark\u001b[60Gmode\u001b[65G(`dark:`)\r\r\n\r\r\n\u001b[6G###\u001b[10GScreen\u001b[17GLevel\r\r\n\u001b[6G-\u001b[8GLayout\u001b[15Guses\u001b[20GTailwind's\u001b[31Gflexbox/grid\u001b[44Gutilities\u001b[54Gconsistently\r\r\n\u001b[6G-\u001b[8GScreen\u001b[15Grespects\u001b[24Gbreakpoint\u001b[35Gsystem\u001b[42G(no\u001b[46Ghardcoded\u001b[56Gpixel\u001b[62Gwidths)\r\r\n\u001b[6G-\u001b[8GTypography\u001b[19Gfollows\u001b[27Gthe\u001b[31Gconfigured\u001b[42Gfont\u001b[47Gscale\r\r\n\u001b[6G-\u001b[8GContainer/max-width\u001b[28Gstrategy\u001b[37Gis\u001b[40Gconsistent\u001b[51Gacross\u001b[58Gscreens\r\r\n\r\r\n\u001b[6G##\u001b[9GSandbox\r\r\n\r\r\n\u001b[6GTailwind\u001b[15Gdoes\u001b[20Gnot\u001b[24Gprovide\u001b[32Gits\u001b[36Gown\u001b[40Gsandbox.\u001b[49GPair\u001b[54Gwith\u001b[59GStorybook\u001b[69G(sandbox\u001b[78Gadapter)\u001b[87Gor\r\r\n\u001b[6Gthe\u001b[10Gframework's\u001b[22Gdev\u001b[26Gserver.\r\r\n\r\r\n\u001b[6G```bash\r\r\n\u001b[6G#\u001b[8GVerify\u001b[15GTailwind\u001b[24Gis\u001b[27Gprocessing\u001b[38Gcorrectly\r\r\n\u001b[6Gnpx\u001b[10Gtailwindcss\u001b[22G--help\u001b[32G#\u001b[34Gconfirm\u001b[42GCLI\u001b[46Gavailable\r\r\n\u001b[6G```\r\r\n\r\r\n\u001b[6GFor\u001b[10Gdebugging,\u001b[21Guse\u001b[25GTailwind's\u001b[36G`@apply`\u001b[45Gsparingly\u001b[55Gand\u001b[59Gprefer\u001b[66Gutility\u001b[74Gclasses\u001b[82Gdirectly\r\r\n\u001b[6Gin\u001b[9Gmarkup.\r\r\n\u001b[6G#####\r\r\n\u001b[6G#\u001b[8GCustom\u001b[15GSandbox\u001b[23G(default)\r\r\n\r\r\n\u001b[6GThe\u001b[10G**default**\u001b[22Gsandbox\u001b[30Gadapter.\u001b[39GInstead\u001b[47Gof\u001b[50Ginstalling\u001b[61Gan\u001b[64Goff-the-shelf\u001b[78Gtool,\u001b[84Git\r\r\n\u001b[6G**generates\u001b[18Ga\u001b[20Gcomponent\u001b[30Gbrowser\u001b[38Gfrom\u001b[43Gscratch\u001b[51Gin\u001b[54Gthe\u001b[58Gproject's\u001b[68Gtarget\u001b[75Gframework**,\r\r\n\u001b[6Gimplementing\u001b[19Gthe\u001b[23Gseven\u001b[29Gpieces\u001b[36Gof\u001b[39G`docs/sandbox-spec.md`.\u001b[63GYou\u001b[67Gown\u001b[71Git,\u001b[75Git's\u001b[80Gtiny,\u001b[86Gand\u001b[90Git\r\r\n\u001b[6Grenders\u001b[14Gthe\u001b[18G*real*\u001b[25Gcomponents\u001b[36G(no\u001b[40Gweb\u001b[44Gprototype\u001b[54Gthrowaway).\r\r\n\r\r\n\u001b[6G##\u001b[9GWhy\u001b[13Gthis\u001b[18Gis\u001b[21Gthe\u001b[25Gdefault\u001b[33G(not\u001b[38GStorybook)\r\r\n\r\r\n\u001b[6G**Storybook\u001b[18Gis\u001b[21Ga\u001b[23Gweb\u001b[27Gtool.**\u001b[35Gpixel-perfect\u001b[49Gbuilds\u001b[56GUI\u001b[59Gin\u001b[62Gany\u001b[66Gframework\u001b[76G—\u001b[78GReact,\r\r\n\u001b[6GSvelteKit,\u001b[17GReact\u001b[23GNative,\u001b[31GGPUI,\u001b[37GRatatui,\u001b[46GSwiftUI.\u001b[55GShoehorning\u001b[67Gall\u001b[71Gof\u001b[74Gthose\u001b[80Ginto\u001b[85Ga\r\r\n\u001b[6Gbrowser-based\u001b[20Gtool\u001b[25Gmeans\u001b[31Gfighting\u001b[40Gthe\u001b[44Gtool\u001b[49Ginstead\u001b[57Gof\u001b[60Gbuilding\u001b[69Gthe\u001b[73Gproduct.\u001b[82GThe\r\r\n\u001b[6Gagentic\u001b[14Gmodel\u001b[20Gmakes\u001b[26Gcustom\u001b[33Ggeneration\u001b[44Gcheap\u001b[50G(~60\u001b[55Glines)\u001b[62Gand\u001b[66GStorybook's\r\r\n\u001b[6Ginstall/configure/maintain\u001b[33Goverhead\u001b[42Gexpensive\u001b[52Gby\u001b[55Gcomparison.\r\r\n\r\r\n\u001b[6G|\u001b[8G|\u001b[10GStorybook\u001b[20G|\u001b[22GCustom\u001b[29G(this\u001b[35Gadapter)\u001b[44G|\r\r\n\u001b[6G|---|---|---|\r\r\n\u001b[6G|\u001b[8GReact\u001b[14Gweb\u001b[18G|\u001b[20G✅\u001b[23Gnative\u001b[30Gfit\u001b[34G|\u001b[36G✅\u001b[39Gtiny\u001b[44GVite\u001b[49Gbrowser,\u001b[58Gsame\u001b[63Gresult\u001b[70G|\r\r\n\u001b[6G|\u001b[8GSvelteKit\u001b[18G|\u001b[21G \u001b[20G⚠️\u001b[23Gneeds\u001b[29Gadapter\u001b[37G|\u001b[39G✅\u001b[42Ggenerated\u001b[52Gin\u001b[55GSvelte\u001b[62G|\r\r\n\u001b[6G|\u001b[8GReact\u001b[14GNative\u001b[21G|\u001b[24G \u001b[23G⚠️\u001b[26Gweb\u001b[30Gshimming\u001b[39G|\u001b[41G✅\u001b[44Gruns\u001b[49Gon-device\u001b[59G|\r\r\n\u001b[6G|\u001b[8GTerminal\u001b[17G(Ratatui\u001b[26Getc.)\u001b[32G|\u001b[34G❌\u001b[37Gimpossible\u001b[48G|\u001b[50G✅\u001b[53Gterminal-native\u001b[69G|\r\r\n\u001b[6G|\u001b[8GDesktop\u001b[16G(GPUI,\u001b[23GSwiftUI)\u001b[32G|\u001b[34G❌\u001b[37Gimpossible\u001b[48G|\u001b[50G✅\u001b[53Gplatform-native\u001b[69G|\r\r\n\u001b[6G|\u001b[8GInstall\u001b[16Gfootprint\u001b[26G|\u001b[28G~200\u001b[33Gdeps\u001b[38G|\u001b[40G~0\u001b[43Gdeps\u001b[48G|\r\r\n\u001b[6G|\u001b[8GMaintenance\u001b[20G|\u001b[22Gversion\u001b[30Gupgrades,\u001b[40Gaddon\u001b[46Gcompat\u001b[53G|\u001b[55Gyou\u001b[59Gown\u001b[63G~60\u001b[67Glines\u001b[73G|\r\r\n\r\r\n\u001b[6GStorybook\u001b[16Gremains\u001b[24Gavailable\u001b[34Gas\u001b[37Gan\u001b[40G**opt-in**\u001b[51G(`tools.sandbox:\u001b[68G\"storybook\"`).\u001b[83GThe\r\r\n\u001b[6Gcustom\u001b[13Gsandbox\u001b[21Gis\u001b[24Gthe\u001b[28Gdefault\u001b[36Gbecause\u001b[44Gthe\u001b[48Gdefault\u001b[56Gshould\u001b[63Gwork\u001b[68Gfor\u001b[72G*every*\u001b[80Gplatform\r\r\n\u001b[6Gwithout\u001b[14Gshoehorning.\r\r\n\r\r\n\u001b[6G---\r\r\n\r\r\n\u001b[6GUse\u001b[10Gan\u001b[13Goff-the-shelf\u001b[27Gadapter\u001b[35G(`docs/adapters/storybook.md`,\u001b[66G`storybook-native.md`,\r\r\n\u001b[6G`tui-sandbox.md`)\u001b[24Gonly\u001b[29Gwhen\u001b[34Gthe\u001b[38Guser\u001b[43Gexplicitly\u001b[54Gasks\u001b[59G(`tools.sandbox:\u001b[76G\"storybook\"`\r\r\n\u001b[6Getc.).\r\r\n\r\r\n\u001b[6G##\u001b[9GPlatforms\r\r\n\u001b[6G-\u001b[8Gall\u001b[12G(web-desktop,\u001b[26Gweb-mobile,\u001b[38Gmobile-ios,\u001b[50Gmobile-android,\u001b[66Gdesktop,\u001b[75Gtui)\u001b[80G—\u001b[82Gthe\r\r\n\u001b[6Gsandbox\u001b[14Gis\u001b[17Ggenerated\u001b[27Gto\u001b[30Gmatch\u001b[36Gthe\u001b[40G**framework**,\u001b[55Gnot\u001b[59Gthe\u001b[63Gplatform.\r\r\n\r\r\n\u001b[6G##\u001b[9GCategory\r\r\n\u001b[6GSandbox\u001b[14G(default\u001b[23G—\u001b[25Gselected\u001b[34Gautomatically\u001b[48Gunless\u001b[55Gthe\u001b[59Guser\u001b[64Grequests\u001b[73Ga\u001b[75Gnamed\u001b[81Gtool)\r\r\n\r\r\n\u001b[6G##\u001b[9GGold-standard\u001b[23Greferences\r\r\n\u001b[6GTwo\u001b[10Greal,\u001b[16Grunnable\u001b[25Gsandboxes\u001b[35Gembody\u001b[42Gthis\u001b[47Gadapter\u001b[55G—\u001b[57Gread\u001b[62Gthem\u001b[67Gwhen\u001b[72Ggenerating:\r\r\n\u001b[6G-\u001b[8G**GPUI\u001b[15G/\u001b[17Gdesktop-GPU\u001b[29G(Rust):**\u001b[39G`../mega-button/sandbox/`\u001b[65G(`crates/sandbox`\u001b[83G+\r\r\n\u001b[6G`crates/ui-tokens`,\u001b[26G`make\u001b[32Gsandbox-run`).\r\r\n\u001b[6G-\u001b[8G**TUI\u001b[14G(Rust/Ratatui):**\u001b[32G`../get-spoke/.tui-storybook/`\r\r\n\u001b[6G(`crates/{tuikit,tui-storybook}`,\u001b[40G`make\u001b[46Gsandbox`\u001b[55G/\u001b[57G`make\u001b[63Gsandbox-check`).\r\r\n\r\r\n\u001b[6G---\r\r\n\r\r\n\u001b[6G##\u001b[9GScaffold\u001b[18G(per\u001b[23Gparadigm)\r\r\n\r\r\n\u001b[6GCreate\u001b[13Ga\u001b[15Gsmall\u001b[21Gsandbox\u001b[29Gproject\u001b[37Gthat\u001b[42Gimports\u001b[50Gthe\u001b[54Gproject's\u001b[64Gcomponents\u001b[75Gand\u001b[79Grenders\u001b[87Gone\r\r\n\u001b[6Gat\u001b[9Ga\u001b[11Gtime.\u001b[17GLayout\u001b[24Gis\u001b[27Galways:\u001b[35G**registry\u001b[46G→\u001b[48Gtwo-pane\u001b[57Gshell\u001b[63G(nav\u001b[68G+\u001b[70Gpreview)\u001b[79G→\u001b[81Gtoken\r\r\n\u001b[6Gcodegen\u001b[14G→\u001b[16Grun\u001b[20Gtarget.**\r\r\n\r\r\n\u001b[6G###\u001b[10GWeb\u001b[14G(React\u001b[21G/\u001b[23GSvelteKit\u001b[33G/\u001b[35GVue\u001b[39G/\u001b[41Gvanilla)\u001b[50G—\u001b[52Ga\u001b[54Gtiny\u001b[59GVite\u001b[64Gbrowser,\u001b[73Gno\u001b[76GStorybook\r\r\n\u001b[6G1.\u001b[9GCreate\u001b[16G`sandbox/`\u001b[27G(a\u001b[30GVite\u001b[35Gentry\u001b[41Galongside\u001b[51Gthe\u001b[55Gapp,\u001b[60Gsharing\u001b[68Gits\u001b[72Gcomponent\u001b[82Gsource):\r\r\n\u001b[9G```\r\r\n\u001b[9Gsandbox/\r\r\n\u001b[11Gindex.html\u001b[31G#\u001b[33Gmounts\u001b[40Gthe\u001b[44Gsandbox\u001b[52Gshell\r\r\n\u001b[11Gmain.{tsx,ts}\u001b[31G#\u001b[33Gtwo-pane\u001b[42Gshell:\u001b[49Gsidebar\u001b[57G(by\u001b[61Glayer)\u001b[68G+\u001b[70Gpreview\u001b[78G+\u001b[80Gbreadcrumb\r\r\n\u001b[11Gregistry.{tsx,ts}\u001b[31G#\u001b[33Gthe\u001b[37Gstory\u001b[43Gregistry\u001b[52G(array\u001b[59Gof\u001b[62G{layer,name,render})\r\r\n\u001b[11Gtokens.css\u001b[31G#\u001b[33GGENERATED\u001b[43Gfrom\u001b[48Gdesign/system/tokens/theme.*.json\r\r\n\u001b[11Ggen-tokens.mjs\u001b[31G#\u001b[33Gcodegen\u001b[41Gscript\u001b[48G(theme.json\u001b[60G→\u001b[62Gtokens.css)\r\r\n\u001b[9G```\r\r\n\u001b[6G2.\u001b[9GAdd\u001b[13Gscripts\u001b[21Gto\u001b[24G`package.json`\u001b[39G—\u001b[41G**run**,\u001b[50G**tokens**,\u001b[62Gand\u001b[66G**capture**\u001b[78G(piece\u001b[85G#8):\r\r\n\u001b[9G```json\r\r\n\u001b[9G{\u001b[11G\"scripts\":\u001b[22G{\r\r\n\u001b[13G\"sandbox:tokens\":\u001b[31G\"node\u001b[37Gsandbox/gen-tokens.mjs\",\r\r\n\u001b[13G\"sandbox\":\u001b[24G\"npm\u001b[29Grun\u001b[33Gsandbox:tokens\u001b[48G&&\u001b[51Gvite\u001b[56G--config\u001b[65Gsandbox/vite.config.ts\",\r\r\n\u001b[13G\"sandbox:capture\":\u001b[32G\"node\u001b[38Gsandbox/capture.mjs\"\r\r\n\u001b[9G}\u001b[11G}\r\r\n\u001b[9G```\r\r\n\u001b[9G`sandbox:capture`\u001b[27Gwalks\u001b[33Gthe\u001b[37Gregistry\u001b[46Gheadless,\u001b[56Gdisables\u001b[65Ganimation,\u001b[76Gsettles,\r\r\n\u001b[6Gserializes\u001b[17Geach\u001b[22Gstory's\u001b[30Gstructural\u001b[41Gartifact\u001b[50G(normalized\u001b[62GDOM\u001b[66Gor\u001b[69Gframework\u001b[79Gequivalent),\r\r\n\u001b[6Gand\u001b[10Gwrites\u001b[17G`design/.captures/{platform}/{layer}/{name}/{state}.txt`\u001b[74G(PNG\u001b[79Goptional\u001b[88Gfor\r\r\n\u001b[6Greview).\u001b[15GRecord\u001b[22Gthe\u001b[26Gcommand\u001b[34Gon\u001b[37Gthe\u001b[41Gplatform\u001b[50Gas\u001b[53G`capture.command`.\r\r\n\u001b[6G3.\u001b[9GThe\u001b[13Gshell\u001b[19G(`main.tsx`,\u001b[32GReact\u001b[38Gexample\u001b[46G—\u001b[48Gadapt\u001b[54Gto\u001b[57Gthe\u001b[61Gframework)\u001b[72Gkeeps\u001b[78G`selected`\r\r\n\u001b[6Gstate,\u001b[13Glists\u001b[19G`registry`\u001b[30Ggrouped\u001b[38Gby\u001b[41G`layer`\u001b[49Gin\u001b[52Ga\u001b[54Gsidebar,\u001b[63Gand\u001b[67Grenders\u001b[75Gthe\u001b[79Gselected\r\r\n\u001b[6Gstory's\u001b[14G`render()`\u001b[25Gin\u001b[28Gthe\u001b[32Gpreview\u001b[40Gwith\u001b[45Ga\u001b[47G`{layer}\u001b[56G/\u001b[58G{name}`\u001b[66Gbreadcrumb.\u001b[78G~60\u001b[82Glines.\r\r\n\u001b[6G4.\u001b[9GImport\u001b[16G`tokens.css`\u001b[29Gso\u001b[32Gcomponents\u001b[43Grender\u001b[50Gthemed.\r\r\n\r\r\n\u001b[6G###\u001b[10GDesktop-GPU\u001b[22G(GPUI,\u001b[29GRust)\r\r\n\u001b[6GMirror\u001b[13G`../mega-button/sandbox/`:\u001b[40Ga\u001b[42Gworkspace\u001b[52Gwith\u001b[57Ga\u001b[59G`sandbox`\u001b[69Gbin\u001b[73Gcrate\u001b[79G(`app.rs`\u001b[89G=\r\r\n\u001b[6G`SandboxApp{stories,\u001b[27Gselected}`\u001b[38G+\u001b[40G`render_nav`/`render_preview`;\u001b[71G`main.rs`\u001b[81G=\u001b[83Gwindow\u001b[90G+\r\r\n\u001b[6G`theme::apply`)\u001b[22Gand\u001b[26Ga\u001b[28G`ui-tokens`\u001b[40Gcrate\u001b[46G(`build.rs`\u001b[58Gcodegen).\u001b[68G`make\u001b[74Gsandbox-run`\u001b[87G→\r\r\n\u001b[6G`cargo\u001b[13Grun`.\r\r\n\r\r\n\u001b[6G###\u001b[10GTUI\u001b[14G(Ratatui,\u001b[24GRust)\r\r\n\u001b[6GMirror\u001b[13G`../get-spoke/.tui-storybook/`:\u001b[45Ga\u001b[47G`tuikit`\u001b[56Gprimitives\u001b[67Gcrate\u001b[73G+\u001b[75Ga\u001b[77G`tui-storybook`\r\r\n\u001b[6Gbin\u001b[10G(`registry/`,\u001b[24G`app.rs`,\u001b[34G`ui/{navigator,preview,footer}.rs`,\u001b[70G`event.rs`,\r\r\n\u001b[6G`selfcheck.rs`).\u001b[23G`make\u001b[29Gsandbox`\u001b[38G(interactive)\u001b[52G+\u001b[54G`make\u001b[60Gsandbox-check`\u001b[75G(headless\r\r\n\u001b[6G`--check`\u001b[16G→\u001b[18Gstdout).\r\r\n\r\r\n\u001b[6G###\u001b[10GNative-mobile\u001b[24G(SwiftUI\u001b[33G/\u001b[35GCompose)\r\r\n\u001b[6GA\u001b[8G`Sandbox`\u001b[18Gbuild\u001b[24Gtarget/scheme:\u001b[39Ga\u001b[41G`List`\u001b[48Gof\u001b[51Gstories\u001b[59Ggrouped\u001b[67Gby\u001b[70Glayer\u001b[76G→\u001b[78Ga\r\r\n\u001b[6G`NavigationStack`/detail\u001b[31Gthat\u001b[36Grenders\u001b[44Gthe\u001b[48Gcomponent\u001b[58Gin\u001b[61Gisolation\u001b[71G(SwiftUI\u001b[80G`#Preview`\r\r\n\u001b[6Gcatalog\u001b[14Gor\u001b[17Ga\u001b[19Gdedicated\u001b[29Gsandbox\u001b[37Gapp\u001b[41Gtarget;\u001b[49GCompose\u001b[57G`@Preview`\u001b[68Ggallery\u001b[76G/\u001b[78Ga\u001b[80Gsandbox\r\r\n\u001b[6Gactivity).\r\r\n\r\r\n\u001b[6G---\r\r\n\r\r\n\u001b[6G##\u001b[9GToken\u001b[15GCodegen\u001b[23G(the\u001b[28Gdesign↔code\u001b[40Gbridge)\r\r\n\r\r\n\u001b[6GGenerate\u001b[15Gtarget-language\u001b[31Gtokens\u001b[38Gfrom\u001b[43G`design/system/tokens/theme.{light,dark}.json`.\r\r\n\u001b[6GComponents\u001b[17Greference\u001b[27Gthese;\u001b[34Gnever\u001b[40Ghardcode.\r\r\n\r\r\n\u001b[6G-\u001b[8G**Web**\u001b[16G—\u001b[18G`gen-tokens.mjs`\u001b[35Greads\u001b[41Gthe\u001b[45Gtheme\u001b[51GJSON\u001b[56Gand\u001b[60Gemits\u001b[66GCSS\u001b[70Gcustom\u001b[77Gproperties:\r\r\n\u001b[8G```js\r\r\n\u001b[8G//\u001b[11Gsandbox/gen-tokens.mjs\u001b[34G—\u001b[36Gtheme.dark.json\u001b[52G→\u001b[54Gtokens.css\u001b[65G(:root\u001b[72G+\r\r\n\u001b[6G[data-theme=light])\r\r\n\u001b[8Gimport\u001b[15G{\u001b[17GreadFileSync,\u001b[31GwriteFileSync\u001b[45G}\u001b[47Gfrom\u001b[52G\"node:fs\";\r\r\n\u001b[8Gconst\u001b[14Gdark\u001b[19G=\r\r\n\u001b[6GJSON.parse(readFileSync(\"design/system/tokens/theme.dark.json\",\"utf8\"));\r\r\n\u001b[8Gconst\u001b[14GtoVars\u001b[21G=\u001b[23G(obj,\u001b[29Gprefix=\"\")\u001b[40G=>\u001b[43GObject.entries(obj).flatMap(([k,v])\u001b[79G=>\r\r\n\u001b[10Gtypeof\u001b[17Gv\u001b[19G===\u001b[23G\"object\"\u001b[32G?\u001b[34GtoVars(v,\u001b[44G`${prefix}${k}-`)\u001b[62G:\u001b[64G[`\u001b[68G--${prefix}${k}:\r\r\n\u001b[6G${v};`]);\r\r\n\u001b[8GwriteFileSync(\"sandbox/tokens.css\",\u001b[44G`:root{\\n${toVars(dark).join(\"\\n\")}\\n}\\n`);\r\r\n\u001b[8G```\r\r\n\u001b[8GComponents\u001b[19Guse\u001b[23G`var(--surface-desktop)`\u001b[48Getc.\u001b[53G(or\u001b[57Gfeed\u001b[62Gthe\u001b[66Gsame\u001b[71Gvars\u001b[76Ginto\u001b[81GTailwind).\r\r\n\u001b[6G-\u001b[8G**GPUI\u001b[15G(Rust)**\u001b[24G—\u001b[26Ga\u001b[28G`build.rs`\u001b[39Gthat\u001b[44Gparses\u001b[51Gthe\u001b[55GJSON\u001b[60Gand\u001b[64Gwrites\u001b[71G`tokens.rs`\u001b[83Gconstants\r\r\n\u001b[6G+\u001b[8G`hex()/rgba()`\u001b[23Ghelpers\u001b[31G(see\u001b[36G`../mega-button/sandbox/crates/ui-tokens/build.rs`);\r\r\n\u001b[6G`cargo:rerun-if-changed`\u001b[31Gon\u001b[34Gthe\u001b[38GJSON.\r\r\n\u001b[6G-\u001b[8G**TUI\u001b[14G(Rust)**\u001b[23G—\u001b[25Gmap\u001b[29Gtokens\u001b[36Gto\u001b[39Ga\u001b[41G`Palette`\u001b[51Gstruct\u001b[58Gof\u001b[61G`Rgb(...)`,\u001b[73Gresolved\u001b[82Gper\u001b[86Gcolor\r\r\n\u001b[6Gmode\u001b[11G(see\u001b[16G`../get-spoke/.tui-storybook/crates/tuikit/src/theme/palettes.rs`).\r\r\n\u001b[6G-\u001b[8G**Native-mobile**\u001b[26G—\u001b[28Gcodegen\u001b[36Ga\u001b[38G`Tokens`\u001b[47Genum/struct\u001b[59G(Swift/Kotlin)\u001b[74Gor\u001b[77Gan\u001b[80Gasset\r\r\n\u001b[6Gcatalog\u001b[14Gfrom\u001b[19Gthe\u001b[23GJSON.\r\r\n\r\r\n\u001b[6G##\u001b[9GStory\u001b[15GRegistry\r\r\n\r\r\n\u001b[6GOne\u001b[10Gexplicit\u001b[19Glist,\u001b[25Gtagged\u001b[32Gby\u001b[35Glayer\u001b[41G(`Tokens·Atoms·Molecules·Organisms·Views`):\r\r\n\u001b[6G-\u001b[8G**Web:**\u001b[17G`export\u001b[25Gconst\u001b[31Gstories\u001b[39G=\u001b[41G[{\u001b[44Glayer:\"Atoms\",\u001b[59Gname:\"Button\",\u001b[74Grender:\u001b[82G()\u001b[85G=>\r\r\n\u001b[6G<Button\u001b[14G…/>,\u001b[19Gtarget:\"design/reference/cockpit-dc/01.png\"\u001b[63G},\u001b[66G…]`.\r\r\n\u001b[6G-\u001b[8G**Rust\u001b[15G(GPUI/TUI):**\u001b[29Ga\u001b[31G`Vec<StoryEntry>`\u001b[49G/\u001b[51G`RegistryBuilder.group(...).story(...)`\r\r\n\u001b[6G(see\u001b[11Grefs).\r\r\n\u001b[6GAdding\u001b[13Ga\u001b[15Gcomponent\u001b[25G=\u001b[27Gadding\u001b[34Gone\u001b[38Gregistry\u001b[47Gline\u001b[52G(the\u001b[57Gbuild\u001b[63Gcommand\u001b[71Gdoes\u001b[76Gthis\u001b[81G—\u001b[83Gsee\r\r\n\u001b[6G`scaffold.md`/`build.md`).\r\r\n\r\r\n\u001b[6G##\u001b[9GNavigator\u001b[19G(two-pane)\r\r\n\u001b[6GLeft:\u001b[12Gsections\u001b[21Gper\u001b[25Glayer\u001b[31Gwith\u001b[36Gtheir\u001b[42Gstories\u001b[50G(click\u001b[57G/\u001b[59Gkeyboard-select).\u001b[77GRight:\r\r\n\u001b[6Gbreadcrumb\u001b[17G`{layer}\u001b[26G/\u001b[28G{name}`\u001b[36G+\u001b[38Gthe\u001b[42Gselected\u001b[51Gstory\u001b[57Grendered\u001b[66Gin\u001b[69Gisolation\u001b[79G(Views\u001b[86Gat\r\r\n\u001b[6Gnatural\u001b[14Gsize).\u001b[21GSelection\u001b[31Gupdates\u001b[39G→\u001b[41Gpreview\u001b[49Gre-renders.\u001b[61GKeep\u001b[66Git\u001b[69G~1\u001b[72Gfile.\r\r\n\r\r\n\u001b[6G##\u001b[9GRun\r\r\n\u001b[6G-\u001b[8GWeb:\u001b[13G`npm\u001b[18Grun\u001b[22Gsandbox`\u001b[31G(dev\u001b[36Gserver).\u001b[45GRust:\u001b[51G`make\u001b[57Gsandbox-run`\u001b[70G/\u001b[72G`make\u001b[78Gsandbox`.\r\r\n\u001b[6GMobile:\u001b[14Gthe\u001b[18GSandbox\u001b[26Gscheme/target.\r\r\n\u001b[6G-\u001b[8GProvide\u001b[16Ga\u001b[18G**headless\u001b[29Gcheck**\u001b[37Gwhere\u001b[43Gfeasible\u001b[52G(TUI\u001b[57G`--check`;\u001b[68Gweb:\u001b[73Ga\u001b[75Gbuild\u001b[81G+\u001b[83Ga\u001b[85Gsmoke\r\r\n\u001b[6Grender)\u001b[14Gfor\u001b[18GCI\u001b[21Gparity.\r\r\n\r\r\n\u001b[6G##\u001b[9GCatalog\u001b[17Gcapture\u001b[25G(piece\u001b[32G#8\u001b[35G—\u001b[37Grequired)\r\r\n\u001b[6GGenerate\u001b[15Ga\u001b[17Gcapture\u001b[25Gcommand\u001b[33Galongside\u001b[43Gthe\u001b[47Grun\u001b[51Gcommand.\u001b[60GThe\u001b[64Gplugin\u001b[71Ggate\u001b[76Gis:\r\r\n\r\r\n\u001b[6G```\r\r\n\u001b[6Gnode\u001b[11G{plugin}/scripts/verify-catalog.mjs\u001b[47G--baseline\u001b[58G<project-root>\u001b[75G#\u001b[77Gwrite\u001b[83Ggoldens\r\r\n\u001b[6Gnode\u001b[11G{plugin}/scripts/verify-catalog.mjs\u001b[47G--check\u001b[55G<project-root>\u001b[75G#\u001b[77Gdrift\u001b[83Ggate\r\r\n\u001b[6Gnode\u001b[11G{plugin}/scripts/verify-catalog.mjs\u001b[47G--blast\u001b[55G<Name>\u001b[62G<project-root>\r\r\n\u001b[6Gnode\u001b[11G{plugin}/scripts/verify-catalog.mjs\u001b[47G--reach\u001b[55G<Name...>\u001b[65G<project-root>\r\r\n\u001b[6G```\r\r\n\r\r\n\u001b[6GGoldens\u001b[14Gland\u001b[19Gat\u001b[22G`design/goldens/{platform}/{layer}/{name}/{state}.{ext}`\u001b[79Gand\u001b[83Gare\r\r\n\u001b[6Gcommitted.\u001b[17GManifest:\r\r\n\r\r\n\u001b[6G```json\r\r\n\u001b[6G\"capture\":\u001b[17G{\r\r\n\u001b[8G\"command\":\u001b[19G\"npm\u001b[24Grun\u001b[28Gsandbox:capture\",\r\r\n\u001b[8G\"medium\":\u001b[18G\"dom+png\",\r\r\n\u001b[8G\"goldens\":\u001b[19G\"design/goldens/web-desktop\"\r\r\n\u001b[6G}\r\r\n\u001b[6G```\r\r\n\r\r\n\u001b[6GDeterminism:\u001b[19Gfixed\u001b[25Gfixtures,\u001b[35Gno\u001b[38Ganimation,\u001b[49Gnormalize\u001b[59Gids/hashes/paths/timestamps\r\r\n\u001b[6Gbefore\u001b[13Gwrite.\u001b[20GStructural\u001b[31Gartifact\u001b[40Gis\u001b[43Gthe\u001b[47Ggate;\u001b[53GPNG\u001b[57Gis\u001b[60Greview-only.\u001b[73GA\u001b[75Gplatform\u001b[84Gthat\r\r\n\u001b[6Gcannot\u001b[13Gcapture\u001b[21Gmust\u001b[26Gdeclare\u001b[34Gthe\u001b[38Gdegradation\u001b[50G—\u001b[52Gnever\u001b[58Gsilent-pass.\r\r\n\r\r\n\u001b[6G##\u001b[9GVerify\u001b[16G(the\u001b[21Gminimum\u001b[29Gbar\u001b[33G—\u001b[35Gsee\u001b[39G`docs/sandbox-spec.md`)\r\r\n\u001b[6G-\u001b[8GEach\u001b[13Gbuilt\u001b[19Gcomponent\u001b[29Gis\u001b[32G**registered\u001b[45Gunder\u001b[51Gits\u001b[55Glayer**\u001b[63Gand\u001b[67G**renders\u001b[77Gin\u001b[80Gisolation**.\r\r\n\u001b[6G-\u001b[8GThe\u001b[12Gcatalog\u001b[20Gis\u001b[23G**navigable**\u001b[37Gwith\u001b[42Ga\u001b[44G`{layer}/{name}`\u001b[61Gbreadcrumb.\r\r\n\u001b[6G-\u001b[8GTokens\u001b[15Gare\u001b[19G**codegenned\u001b[32Gfrom\u001b[37G`theme.*.json`**\u001b[54G—\u001b[56Gno\u001b[59Ghardcoded\u001b[69Gcolors/spacing\u001b[84Gin\r\r\n\u001b[6Gcomponents.\r\r\n\u001b[6G-\u001b[8GOne\u001b[12G**run\u001b[18Gcommand**\u001b[28Glaunches\u001b[37Git;\u001b[41Geach\u001b[46Gstory\u001b[52Gnames\u001b[58Gits\u001b[62G**pixel-target**\r\r\n\u001b[6G(`design/reference/{slug}/{NN}.png`).\r\r\n\u001b[6G-\u001b[8GA\u001b[10G**capture\u001b[20Gcommand**\u001b[30Gexists;\u001b[38Ghello-world\u001b[50Ghas\u001b[54Ga\u001b[56Ggolden;\u001b[64G`--check`\u001b[74Gis\u001b[77Gwired\u001b[83Ginto\r\r\n\u001b[6Gverify.\r\r\n\r\r\n\u001b[6G##\u001b[9GWhen\u001b[14Gto\u001b[17Guse\u001b[21Ga\u001b[23Gnamed\u001b[29Gtool\u001b[34Ginstead\r\r\n\u001b[6GIf\u001b[9Gthe\u001b[13Guser\u001b[18Gasks\u001b[23Gfor\u001b[27GStorybook\u001b[37G(web),\u001b[44Gon-device\u001b[54GStorybook\u001b[64G(mobile),\u001b[74Gor\u001b[77G`tsbx`\u001b[84G(TUI),\r\r\n\u001b[6Gset\u001b[10G`tools.sandbox`\u001b[26Gaccordingly\u001b[38Gand\u001b[42Gfollow\u001b[49Gthat\u001b[54Gadapter.\u001b[63GThe\u001b[67Gcustom\u001b[74Gsandbox\u001b[82Gis\u001b[85Gthe\r\r\n\u001b[6Gdefault\u001b[14Gbecause\u001b[22Git's\u001b[27Gsmall,\u001b[34Gframework-native,\u001b[52Gand\u001b[56Grenders\u001b[64Gthe\u001b[68Greal\u001b[73Gcomponents.\r\r\n\u001b[6G#####\r\r\n\u001b[6G//\u001b[9GThe\u001b[13Gsandbox\u001b[21Gshell:\u001b[28Gsidebar\u001b[36Ggrouped\u001b[44Gby\u001b[47Glayer,\u001b[54Gpreview\u001b[62Gwith\u001b[67Gbreadcrumb,\u001b[79Gand\u001b[83Ga\r\r\n\u001b[6Gcontrols\u001b[15Gpanel.\r\r\n\u001b[6G//\u001b[9G`?story={layer}/{name}&state={state}&bare=1`\u001b[54Grenders\u001b[62Gone\u001b[66Gstory\u001b[72Galone,\u001b[79Gwhich\u001b[85Gis\u001b[88Gwhat\r\r\n\u001b[6Gcapture\u001b[14Gscreenshots.\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GStrictMode,\u001b[27GuseEffect,\u001b[38GuseState\u001b[47G}\u001b[49Gfrom\u001b[54G\"react\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GcreateRoot\u001b[26G}\u001b[28Gfrom\u001b[33G\"react-dom/client\";\r\r\n\u001b[6Gimport\u001b[13G\"../src/index.css\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15Gcn\u001b[18G}\u001b[20Gfrom\u001b[25G\"../src/lib/cn\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15Gstories\u001b[23G}\u001b[25Gfrom\u001b[30G\"./registry\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GLAYERS,\u001b[23GstoryStates,\u001b[36Gtype\u001b[41GAnyStory,\u001b[51Gtype\u001b[56GControl\u001b[64G}\u001b[66Gfrom\u001b[71G\"./story\";\r\r\n\r\r\n\u001b[6Gconst\u001b[12GstoryId\u001b[20G=\u001b[22G(story:\u001b[30GAnyStory)\u001b[40G=>\u001b[43G`${story.layer}/${story.name}`;\r\r\n\r\r\n\u001b[6Gfunction\u001b[15GreadLocation()\u001b[30G{\r\r\n\u001b[8Gconst\u001b[14Gparams\u001b[21G=\u001b[23Gnew\u001b[27GURLSearchParams(window.location.search);\r\r\n\u001b[8Gconst\u001b[14Gstory\u001b[20G=\u001b[22Gstories.find((s)\u001b[39G=>\u001b[42GstoryId(s)\u001b[53G===\u001b[57Gparams.get(\"story\"))\u001b[78G??\u001b[81Gstories[0];\r\r\n\u001b[8Gconst\u001b[14Gstate\u001b[20G=\u001b[22Gparams.get(\"state\")\u001b[42G??\u001b[45G\"default\";\r\r\n\u001b[8Greturn\u001b[15G{\u001b[17Gstory,\u001b[24Gstate:\u001b[31Gstate\u001b[37Gin\u001b[40GstoryStates(story)\u001b[59G?\u001b[61Gstate\u001b[67G:\u001b[69G\"default\",\u001b[80Gbare:\r\r\n\u001b[6Gparams.has(\"bare\")\u001b[25G};\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6Gfunction\u001b[15GControlInput({\u001b[30Gcontrol,\u001b[39Gvalue,\u001b[46GonChange\u001b[55G}:\u001b[58G{\u001b[60Gcontrol:\u001b[69GControl;\u001b[78Gvalue:\r\r\n\u001b[6Gunknown;\u001b[15GonChange:\u001b[25G(v:\u001b[29Gunknown)\u001b[38G=>\u001b[41Gvoid\u001b[46G})\u001b[49G{\r\r\n\u001b[8Gconst\u001b[14Gfield\u001b[20G=\u001b[22G\"w-full\u001b[30Grounded-sm\u001b[41Gborder\u001b[48Gborder-border\u001b[62Gbg-card\u001b[70Gpx-2\u001b[75Gpy-1.5\r\r\n\u001b[6Gtext-caption\";\r\r\n\u001b[8Gif\u001b[11G(control.type\u001b[25G===\u001b[29G\"boolean\")\u001b[40G{\r\r\n\u001b[10Greturn\u001b[17G<input\u001b[24Gtype=\"checkbox\"\u001b[40GclassName=\"size-4\u001b[58Gaccent-primary\"\r\r\n\u001b[6Gchecked={Boolean(value)}\u001b[31GonChange={(e)\u001b[45G=>\u001b[48GonChange(e.target.checked)}\u001b[76G/>;\r\r\n\u001b[8G}\r\r\n\u001b[8Gif\u001b[11G(control.type\u001b[25G===\u001b[29G\"select\")\u001b[39G{\r\r\n\u001b[10Greturn\u001b[17G(\r\r\n\u001b[12G<select\u001b[20GclassName={field}\u001b[38Gvalue={String(value)}\u001b[60GonChange={(e)\u001b[74G=>\r\r\n\u001b[6GonChange(e.target.value)}>\r\r\n\u001b[14G{control.options.map((option)\u001b[44G=>\u001b[47G(\r\r\n\u001b[16G<option\u001b[24Gkey={option}>{option}</option>\r\r\n\u001b[14G))}\r\r\n\u001b[12G</select>\r\r\n\u001b[10G);\r\r\n\u001b[8G}\r\r\n\u001b[8Greturn\u001b[15G<input\u001b[22Gtype=\"text\"\u001b[34GclassName={field}\u001b[52Gvalue={String(value\u001b[72G??\u001b[75G\"\")}\r\r\n\u001b[6GonChange={(e)\u001b[20G=>\u001b[23GonChange(e.target.value)}\u001b[49G/>;\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6Gfunction\u001b[15GSandbox()\u001b[25G{\r\r\n\u001b[8Gconst\u001b[14G[{\u001b[17Gstory,\u001b[24Gstate,\u001b[31Gbare\u001b[36G},\u001b[39GsetLocation]\u001b[52G=\u001b[54GuseState(readLocation);\r\r\n\u001b[8Gconst\u001b[14Gstates\u001b[21G=\u001b[23GstoryStates(story);\r\r\n\u001b[8Gconst\u001b[14G[args,\u001b[21GsetArgs]\u001b[30G=\u001b[32GuseState<Record<string,\u001b[56Gunknown>>(states[state]\u001b[80Gas\r\r\n\u001b[6GRecord<string,\u001b[21Gunknown>);\r\r\n\r\r\n\u001b[8GuseEffect(()\u001b[21G=>\u001b[24G{\r\r\n\u001b[10Gconst\u001b[16GonPop\u001b[22G=\u001b[24G()\u001b[27G=>\u001b[30G{\r\r\n\u001b[12Gconst\u001b[18Gnext\u001b[23G=\u001b[25GreadLocation();\r\r\n\u001b[12GsetLocation(next);\r\r\n\u001b[12GsetArgs(storyStates(next.story)[next.state]\u001b[56Gas\u001b[59GRecord<string,\u001b[74Gunknown>);\r\r\n\u001b[10G};\r\r\n\u001b[10Gwindow.addEventListener(\"popstate\",\u001b[46GonPop);\r\r\n\u001b[10Greturn\u001b[17G()\u001b[20G=>\u001b[23Gwindow.removeEventListener(\"popstate\",\u001b[62GonPop);\r\r\n\u001b[8G},\u001b[11G[]);\r\r\n\r\r\n\u001b[8Gconst\u001b[14Gselect\u001b[21G=\u001b[23G(next:\u001b[30GAnyStory,\u001b[40GnextState\u001b[50G=\u001b[52G\"default\")\u001b[63G=>\u001b[66G{\r\r\n\u001b[10Gwindow.history.pushState(null,\u001b[41G\"\",\u001b[45G`?story=${storyId(next)}&state=${nextState}`);\r\r\n\u001b[10GsetLocation({\u001b[24Gstory:\u001b[31Gnext,\u001b[37Gstate:\u001b[44GnextState,\u001b[55Gbare:\u001b[61Gfalse\u001b[67G});\r\r\n\u001b[10GsetArgs(storyStates(next)[nextState]\u001b[47Gas\u001b[50GRecord<string,\u001b[65Gunknown>);\r\r\n\u001b[8G};\r\r\n\r\r\n\u001b[8Gif\u001b[11G(bare)\u001b[18Greturn\u001b[25G<div\u001b[30GclassName=\"inline-block\u001b[54Gp-12\">{story.render(args)}</div>;\r\r\n\r\r\n\u001b[8Gconst\u001b[14GlayerLabel\u001b[25G=\u001b[27GLAYERS.find((layer)\u001b[47G=>\u001b[50Glayer.id\u001b[59G===\u001b[63Gstory.layer)?.label;\r\r\n\u001b[8Gconst\u001b[14Gcontrols\u001b[23G=\u001b[25GObject.entries(story.argTypes\u001b[55G??\u001b[58G{})\u001b[62Gas\u001b[65G[string,\u001b[74GControl][];\r\r\n\r\r\n\u001b[8Greturn\u001b[15G(\r\r\n\u001b[10G<div\u001b[15GclassName=\"flex\u001b[31Gh-screen\">\r\r\n\u001b[12G<nav\u001b[17Garia-label=\"Stories\"\u001b[38GclassName=\"w-60\u001b[54Gshrink-0\u001b[63Goverflow-y-auto\u001b[79Gborder-r\r\r\n\u001b[6Gborder-border\u001b[20Gbg-card\u001b[28Gp-4\">\r\r\n\u001b[14G{LAYERS.map((layer)\u001b[34G=>\u001b[37G{\r\r\n\u001b[16Gconst\u001b[22Gitems\u001b[28G=\u001b[30Gstories.filter((s)\u001b[49G=>\u001b[52Gs.layer\u001b[60G===\u001b[64Glayer.id);\r\r\n\u001b[16Greturn\u001b[23G(\r\r\n\u001b[18G<section\u001b[27Gkey={layer.id}\u001b[42GclassName=\"mb-6\">\r\r\n\u001b[20G<h2\u001b[24GclassName=\"mb-2\u001b[40Gtext-overline\u001b[54Gfont-mono\u001b[64Guppercase\r\r\n\u001b[6Gtext-muted-foreground\">{layer.label}</h2>\r\r\n\u001b[20G{items.length\u001b[34G===\u001b[38G0\u001b[40G&&\u001b[43G<p\u001b[46GclassName=\"px-2\u001b[62Gtext-caption\r\r\n\u001b[6Gtext-muted-foreground\">None\u001b[34Gyet</p>}\r\r\n\u001b[20G<ul>\r\r\n\u001b[22G{items.map((item)\u001b[40G=>\u001b[43G(\r\r\n\u001b[24G<li\u001b[28Gkey={item.name}>\r\r\n\u001b[26G<button\r\r\n\u001b[28Gtype=\"button\"\r\r\n\u001b[28Garia-current={item\u001b[47G===\u001b[51Gstory\u001b[57G?\u001b[59G\"page\"\u001b[66G:\u001b[68Gundefined}\r\r\n\u001b[28GonClick={()\u001b[40G=>\u001b[43Gselect(item)}\r\r\n\u001b[28GclassName={cn(\r\r\n\u001b[30G\"w-full\u001b[38Grounded-sm\u001b[49Gpx-2\u001b[54Gpy-1.5\u001b[61Gtext-left\u001b[71Gtext-caption\r\r\n\u001b[6Gfocus-visible:outline-2\u001b[30Gfocus-visible:outline-primary\",\r\r\n\u001b[30Gitem\u001b[35G===\u001b[39Gstory\u001b[45G?\u001b[47G\"bg-accent\u001b[58Gtext-accent-foreground\"\u001b[82G:\r\r\n\u001b[6G\"hover:bg-background\",\r\r\n\u001b[28G)}\r\r\n\u001b[26G>\r\r\n\u001b[28G{item.name}\r\r\n\u001b[26G</button>\r\r\n\u001b[24G</li>\r\r\n\u001b[22G))}\r\r\n\u001b[20G</ul>\r\r\n\u001b[18G</section>\r\r\n\u001b[16G);\r\r\n\u001b[14G})}\r\r\n\u001b[12G</nav>\r\r\n\u001b[12G<div\u001b[17GclassName=\"flex\u001b[33Gmin-w-0\u001b[41Gflex-1\u001b[48Gflex-col\">\r\r\n\u001b[14G<header\u001b[22GclassName=\"flex\u001b[38Gitems-center\u001b[51Gjustify-between\u001b[67Ggap-6\u001b[73Gborder-b\r\r\n\u001b[6Gborder-border\u001b[20Gpx-6\u001b[25Gpy-3\">\r\r\n\u001b[16G<h1\u001b[20GclassName=\"text-caption\">\r\r\n\u001b[18G<span\u001b[24GclassName=\"text-muted-foreground\">{layerLabel}\u001b[71G/\u001b[73G</span>\r\r\n\u001b[18G{story.name}\r\r\n\u001b[16G</h1>\r\r\n\u001b[16G<div\u001b[21GclassName=\"flex\u001b[37Gitems-center\u001b[50Ggap-1\">\r\r\n\u001b[18G{Object.keys(states).map((name)\u001b[50G=>\u001b[53G(\r\r\n\u001b[20G<button\r\r\n\u001b[22Gkey={name}\r\r\n\u001b[22Gtype=\"button\"\r\r\n\u001b[22Garia-pressed={name\u001b[41G===\u001b[45Gstate}\r\r\n\u001b[22GonClick={()\u001b[34G=>\u001b[37Gselect(story,\u001b[51Gname)}\r\r\n\u001b[22GclassName={cn(\r\r\n\u001b[24G\"rounded-full\u001b[38Gpx-2.5\u001b[45Gpy-1\u001b[50Gtext-tag\u001b[59Gfont-mono\u001b[69Gfocus-visible:outline-2\r\r\n\u001b[6Gfocus-visible:outline-primary\",\r\r\n\u001b[24Gname\u001b[29G===\u001b[33Gstate\u001b[39G?\u001b[41G\"bg-accent\u001b[52Gtext-accent-foreground\"\u001b[76G:\r\r\n\u001b[6G\"text-muted-foreground\u001b[29Ghover:bg-card\",\r\r\n\u001b[22G)}\r\r\n\u001b[20G>\r\r\n\u001b[22G{name}\r\r\n\u001b[20G</button>\r\r\n\u001b[18G))}\r\r\n\u001b[16G</div>\r\r\n\u001b[14G</header>\r\r\n\u001b[14G<main\u001b[20GclassName=\"flex-1\u001b[38Goverflow-auto\u001b[52Gp-12\">\r\r\n\u001b[16G<div\u001b[21GclassName={cn(story.layer\u001b[47G===\u001b[51G\"screens\"\u001b[61G&&\r\r\n\u001b[6G\"w-max\")}>{story.render(args)}</div>\r\r\n\u001b[14G</main>\r\r\n\u001b[14G<footer\u001b[22GclassName=\"border-t\u001b[42Gborder-border\u001b[56Gbg-card\u001b[64Gpx-6\u001b[69Gpy-4\">\r\r\n\u001b[16G{controls.length\u001b[33G>\u001b[35G0\u001b[37G&&\u001b[40G(\r\r\n\u001b[18G<div\u001b[23GclassName=\"mb-3\u001b[39Ggrid\u001b[44Ggrid-cols-4\u001b[56Ggap-4\">\r\r\n\u001b[20G{controls.map(([prop,\u001b[42Gcontrol])\u001b[52G=>\u001b[55G(\r\r\n\u001b[22G<label\u001b[29Gkey={prop}\u001b[40GclassName=\"grid\u001b[56Gcontent-start\u001b[70Ggap-1\">\r\r\n\u001b[24G<span\u001b[30GclassName=\"text-tag\u001b[50Gfont-mono\r\r\n\u001b[6Gtext-muted-foreground\">{prop}</span>\r\r\n\u001b[24G<ControlInput\u001b[38Gcontrol={control}\u001b[56Gvalue={args[prop]}\u001b[75GonChange={(value)\r\r\n\u001b[6G=>\u001b[9GsetArgs({\u001b[19G...args,\u001b[28G[prop]:\u001b[36Gvalue\u001b[42G})}\u001b[46G/>\r\r\n\u001b[22G</label>\r\r\n\u001b[20G))}\r\r\n\u001b[18G</div>\r\r\n\u001b[16G)}\r\r\n\u001b[16G<p\u001b[19GclassName=\"text-tag\u001b[39Gfont-mono\u001b[49Gtext-muted-foreground\">Target:\r\r\n\u001b[6G{story.target\u001b[20G??\u001b[23G\"none\"}</p>\r\r\n\u001b[14G</footer>\r\r\n\u001b[12G</div>\r\r\n\u001b[10G</div>\r\r\n\u001b[8G);\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6GcreateRoot(document.getElementById(\"root\")!).render(\r\r\n\u001b[8G<StrictMode>\r\r\n\u001b[10G<Sandbox\u001b[19G/>\r\r\n\u001b[8G</StrictMode>,\r\r\n\u001b[6G);\r\r\n\u001b[6G//\u001b[9GTarget:\u001b[17Gmockups/pricing.html\u001b[38G—\u001b[40Gthe\u001b[44Gtype\u001b[49Groles\u001b[55Gthe\u001b[59Gdesign\u001b[66Guses.\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GdefineStory\u001b[27G}\u001b[29Gfrom\u001b[34G\"../story\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15Gtokens\u001b[22G}\u001b[24Gfrom\u001b[29G\"../tokens.generated\";\r\r\n\r\r\n\u001b[6Gconst\u001b[12GSAMPLES:\u001b[21GRecord<string,\u001b[36Gstring>\u001b[44G=\u001b[46G{\r\r\n\u001b[8Gdisplay:\u001b[17G\"One\u001b[22Gprice\u001b[28Gper\u001b[32Gseat.\u001b[38GNo\u001b[41Gsurprises.\",\r\r\n\u001b[8Gprice:\u001b[15G\"$24\",\r\r\n\u001b[8Glede:\u001b[14G\"Start\u001b[21Gfree,\u001b[27Gmove\u001b[32Gup\u001b[35Gwhen\u001b[40Gthe\u001b[44Gteam\u001b[49Gdoes.\",\r\r\n\u001b[8Gtitle:\u001b[15G\"Team\",\r\r\n\u001b[8Gbody:\u001b[14G\"Every\u001b[21Gplan\u001b[26Gincludes\u001b[35Gthe\u001b[39Gfull\u001b[44Geditor.\",\r\r\n\u001b[8G\"body-sm\":\u001b[19G\"Unlimited\u001b[30Gprojects\",\r\r\n\u001b[8Gcaption:\u001b[17G\"For\u001b[22Gteams\u001b[28Gthat\u001b[33Gship\u001b[38Gweekly.\",\r\r\n\u001b[8Glabel:\u001b[15G\"Choose\u001b[23Gplan\",\r\r\n\u001b[8Goverline:\u001b[18G\"PRICING\",\r\r\n\u001b[8Gtag:\u001b[13G\"Most\u001b[19Gpopular\",\r\r\n\u001b[6G};\r\r\n\r\r\n\u001b[6Gfunction\u001b[15GTypography()\u001b[28G{\r\r\n\u001b[8Greturn\u001b[15G(\r\r\n\u001b[10G<div\u001b[15GclassName=\"grid\u001b[31Ggap-12\">\r\r\n\u001b[12G<section>\r\r\n\u001b[14G<h2\u001b[18GclassName=\"mb-4\u001b[34Gtext-overline\u001b[48Gfont-mono\u001b[58Guppercase\r\r\n\u001b[6Gtext-muted-foreground\">Type\u001b[34Groles</h2>\r\r\n\u001b[14G<ul\u001b[18GclassName=\"grid\u001b[34Ggap-6\">\r\r\n\u001b[16G{tokens.typography.map((role)\u001b[46G=>\u001b[49G(\r\r\n\u001b[18G<li\u001b[22Gkey={role.name}\u001b[38GclassName=\"grid\u001b[54Ggrid-cols-[--spacing(60)_1fr]\r\r\n\u001b[6Gitems-baseline\u001b[21Ggap-6\">\r\r\n\u001b[20G<div>\r\r\n\u001b[22G<div\u001b[27GclassName=\"text-caption\">{role.name}</div>\r\r\n\u001b[22G<div\u001b[27GclassName=\"text-tag\u001b[47Gfont-mono\u001b[57Gtext-muted-foreground\">\r\r\n\u001b[24G{role.size}\u001b[36G/\u001b[38G{role.lineHeight}\u001b[56G·\u001b[58G{role.fontWeight}\u001b[76G·\u001b[78G{role.family}\r\r\n\u001b[22G</div>\r\r\n\u001b[20G</div>\r\r\n\u001b[20G<div\u001b[25GclassName={role.className}>{SAMPLES[role.name]\u001b[72G??\u001b[75Grole.name}</div>\r\r\n\u001b[18G</li>\r\r\n\u001b[16G))}\r\r\n\u001b[14G</ul>\r\r\n\u001b[12G</section>\r\r\n\u001b[12G<section>\r\r\n\u001b[14G<h2\u001b[18GclassName=\"mb-4\u001b[34Gtext-overline\u001b[48Gfont-mono\u001b[58Guppercase\r\r\n\u001b[6Gtext-muted-foreground\">Families</h2>\r\r\n\u001b[14G<ul\u001b[18GclassName=\"grid\u001b[34Ggap-6\">\r\r\n\u001b[16G{tokens.fonts.map((font)\u001b[41G=>\u001b[44G(\r\r\n\u001b[18G<li\u001b[22Gkey={font.name}\u001b[38GclassName=\"grid\u001b[54Ggrid-cols-[--spacing(60)_1fr]\r\r\n\u001b[6Gitems-baseline\u001b[21Ggap-6\">\r\r\n\u001b[20G<div>\r\r\n\u001b[22G<div\u001b[27GclassName=\"text-caption\">{font.name}</div>\r\r\n\u001b[22G<div\u001b[27GclassName=\"text-tag\u001b[47Gfont-mono\r\r\n\u001b[6Gtext-muted-foreground\">{font.value}</div>\r\r\n\u001b[20G</div>\r\r\n\u001b[20G<div\u001b[25GclassName={`text-title\u001b[48G${font.className}`}>ABCDEFGHIJKLM\r\r\n\u001b[6Gabcdefghijklm\u001b[20G0123456789</div>\r\r\n\u001b[18G</li>\r\r\n\u001b[16G))}\r\r\n\u001b[14G</ul>\r\r\n\u001b[12G</section>\r\r\n\u001b[10G</div>\r\r\n\u001b[8G);\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6Gexport\u001b[13Gdefault\u001b[21GdefineStory({\r\r\n\u001b[8Glayer:\u001b[15G\"tokens\",\r\r\n\u001b[8Gname:\u001b[14G\"Typography\",\r\r\n\u001b[8Gtarget:\u001b[16G\"mockups/pricing.html\",\r\r\n\u001b[8Grender:\u001b[16G()\u001b[19G=>\u001b[22G<Typography\u001b[34G/>,\r\r\n\u001b[8Gargs:\u001b[14G{},\r\r\n\u001b[6G});\r\r\n\u001b[6G#####\r\r\n\u001b[6G#!/usr/bin/env\u001b[21Gnode\r\r\n\u001b[6G//\u001b[9Gverify-catalog.mjs\u001b[28G—\u001b[30Gdeterministic\u001b[44Gcatalog-capture\u001b[60Ggate.\r\r\n\u001b[6G//\r\r\n\u001b[6G//\u001b[9GRuns\u001b[14Gthe\u001b[18Gproject's\u001b[28Gsandbox\u001b[36Gcapture\u001b[44Gcommand\u001b[52G(or\u001b[56Ga\u001b[58Gstructural\u001b[69Gcatalog\u001b[77Gwalk),\u001b[84Gthen\r\r\n\u001b[6G//\u001b[9Gcompares\u001b[18Gthe\u001b[22Gresulting\u001b[32Gstructural\u001b[43Gartifacts\u001b[53Gto\u001b[56Gcommitted\u001b[66Ggoldens.\u001b[75GStaleness\u001b[85Gis\r\r\n\u001b[6G//\u001b[9Gnever\u001b[15Gstored\u001b[22G—\u001b[24Git\u001b[27Gis\u001b[30Gcomputed\u001b[39Gat\u001b[42Gread\u001b[47Gtime\u001b[52Gby\u001b[55Gre-capturing\u001b[68Gand\u001b[72Gdiffing.\r\r\n\u001b[6G//\r\r\n\u001b[6G//\u001b[9GZero\u001b[14Gruntime\u001b[22Gdependencies.\u001b[36GExit\u001b[41Gvocabulary\u001b[52Gmatches\u001b[60Gverify-styling-contract.mjs:\r\r\n\u001b[6G//\u001b[11G0\u001b[13Gpass\u001b[18G·\u001b[20G1\u001b[22Gdrift/violations\u001b[39G·\u001b[41G2\u001b[43Gconfig/usage\u001b[56Gerror\u001b[62G·\u001b[64G3\u001b[66Gvacuous\u001b[74Gscan\r\r\n\u001b[6G//\r\r\n\u001b[6G//\u001b[9GUsage:\r\r\n\u001b[6G//\u001b[11Gnode\u001b[16Gverify-catalog.mjs\u001b[35G<mode>\u001b[42G<project-root>\u001b[57G[options]\r\r\n\u001b[6G//\r\r\n\u001b[6G//\u001b[9GModes\u001b[15G(exactly\u001b[24Gone):\r\r\n\u001b[6G//\u001b[11G--baseline\u001b[33Gcapture\u001b[41G→\u001b[43Gwrite\u001b[49Ggoldens\u001b[57G(after\u001b[64Ga\u001b[66Glayer\u001b[72Gis\u001b[75Gapproved)\r\r\n\u001b[6G//\u001b[11G--check\u001b[33Gcapture\u001b[41G→\u001b[43Gdiff\u001b[48Gvs\u001b[51Ggoldens;\u001b[60Gnon-zero\u001b[69Gon\u001b[72Gunreviewed\u001b[83Gdrift\r\r\n\u001b[6G//\u001b[11G--blast\u001b[19G<name>\u001b[33Gperturb\u001b[41G<name>,\u001b[49Greport\u001b[56Gwhich\u001b[62Gstories\u001b[70Gmove\u001b[75G(downstream)\r\r\n\u001b[6G//\u001b[11G--reach\u001b[19G<name...>\u001b[33Greport\u001b[40Gwhich\u001b[46Glive\u001b[51Groots\u001b[57Geach\u001b[62Gname\u001b[67Greaches\u001b[75G(upstream)\r\r\n\u001b[6G//\u001b[11G--accept\u001b[20G<glob>\u001b[33Gpromote\u001b[41Gdrifted\u001b[49Gcaptures\u001b[58Gto\u001b[61Ggoldens\u00