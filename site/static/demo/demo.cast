[0.074,"o","\u001b[?25l\u001b[2D\u001b[4B\r\u001b[22C\u001b[7A\u001b[38;5;246mermissionRequest\u001b[40Ghook ·\u001b[47G1m 54s · ↓\u001b[39m \u001b[38;5;246m11.4k tokens)\u001b[39m\r\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[2C\u001b[4A\u001b[?25h\u001b[?25l\u001b[2D\u001b[4B\r\u001b[7A\u001b[38;5;174m✻\u001b[39m\r\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[2C\u001b[4A\u001b[?25h\u001b[?25l\u001b[2D\u001b[4B\r\u001b[5C\u001b[9A\u001b[38;5;246mRunn\r\u001b[83C\u001b[7B270\u001b[39m\r\r\n\r\n\u001b[2C\u001b[4A\u001b[?25h\u001b[?25l\u001b[2D\u001b[4B\r\u001b[5C\u001b[9A\u001b[38;5;211mError: Exit code 1\r\u001b[5C\u001b[1B---\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;211mid: tailwind-web\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;211mname: Tailwind CSS (Web)\r\u001b[1B\u001b[39m     \u001b[38;5;211mappliesTo:\u001b[39m\u001b[K\r\u001b[1B  \u001b[6G\u001b[38;5;211m  platforms: [web-desktop, web-mobile]\r\u001b[1B\u001b[39m     \u001b[38;5;211m  frameworks: [react, nextjs, vite]\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;211m  styleSystem: tailwind\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;211m  componentLibrary: any\u001b[77G\u001b[39m\u001b[K\r\r\n\u001b[6G\u001b[38;5;211msource:\u001b[14Gbuiltin\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mcanonicalDocs:\u001b[21Ghttps://tailwindcss.com/docs\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mlastUpdated:\u001b[19G2026-06-13\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m---\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211m#\u001b[8GTailwind\u001b[17GCSS\u001b[21G(Web)\u001b[27G—\u001b[29GStyling\u001b[37GContract\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211mAll\u001b[10Gstyling\u001b[18Gis\u001b[21Gexpressed\u001b[31Gas\u001b[34G**Tailwind\u001b[45Gutility\u001b[53Gclasses**\u001b[63Gapplied\u001b[71Gthrough\u001b[79Gthe\u001b[83G`className`\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mprop\u001b[11G(React-family:\u001b[26GReact\u001b[32G/\u001b[34GNext.js\u001b[42G/\u001b[44GVite).\u001b[51GThere\u001b[57Gare\u001b[61Gno\u001b[64Gper-component\u001b[78GCSS\u001b[82Gfiles,\u001b[89Gno\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mglobal\u001b[13Gcustom\u001b[20Gclasses,\u001b[29Gand\u001b[33Gno\u001b[36Ginline\u001b[43Gstyle\u001b[49Gobjects.\u001b[58GDesign\u001b[65Gtokens\u001b[72Greach\u001b[78Gcomponents\u001b[89Gthrough\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mTailwind's\u001b[17Gtheme\u001b[23G(CSS\u001b[28Gcustom\u001b[35Gproperties\u001b[46Gmapped\u001b[53Ginto\u001b[58Gthe\u001b[62GTailwind\u001b[71Gtheme\u001b[77Gconfig)\u001b[85Gand\u001b[89Gare\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mconsumed\u001b[15Gas\u001b[18Gutilities\u001b[28G(`bg-primary`,\u001b[43G`text-foreground`,\u001b[62G`border-border`).\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211m>\u001b[8G**Scope:**\u001b[19GThis\u001b[24Gbuilt-in\u001b[33Gcovers\u001b[40Gthe\u001b[44Gframeworks\u001b[55Gin\u001b[58G`appliesTo.frameworks`\u001b[81G(`react`,\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m`nextjs`,\u001b[16G`vite`)\u001b[24G—\u001b[26Gwhere\u001b[32Gthe\u001b[36Gclass\u001b[42Gattribute\u001b[52Gis\u001b[55G`className`.\u001b[68GSvelteKit/Vue\u001b[82G+\u001b[84GTailwind\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mresolve\u001b[14Gthrough\u001b[22G`pixel-perfect:research\u001b[46G--styling`,\u001b[58Gwhich\u001b[64Gsynthesizes\u001b[76Ga\u001b[78Gcontract\u001b[87Gwith\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mframework-correct\u001b[24Gchecks\u001b[31G(`class=`\u001b[41Grather\u001b[48Gthan\u001b[53G`className=`).\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211mThis\u001b[11Gcontract\u001b[20Gexists\u001b[27Gprecisely\u001b[37Gbecause\u001b[45G\"declared\u001b[55GTailwind\"\u001b[65Gis\u001b[68Geasy\u001b[73Gto\u001b[76Gbypass:\u001b[84Gwithout\u001b[92Gan\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211menforced\u001b[15Grule,\u001b[21Ga\u001b[23Gbuild\u001b[29Gcan\u001b[33Gship\u001b[38Ga\u001b[40Gparallel\u001b[49Gglobal-CSS\u001b[60Gsystem\u001b[67Gof\u001b[70Gcustom\u001b[77G`.atom-*`\u001b[87G/\u001b[89G`.mol-*`\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mclasses\u001b[14G(the\u001b[19G`fabrio`\u001b[28Gfailure).\u001b[38GThe\u001b[42Gchecks\u001b[49Gbelow\u001b[55Gmake\u001b[60Gthat\u001b[65Gdrift\u001b[71Ga\u001b[73Gblocking\u001b[82Gviolation.\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211m##\u001b[9GEmit\u001b[14Gmethod\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211m**How:**\u001b[15G`utility-classes-via-className`\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211mExpress\u001b[14Gevery\u001b[20Gvisual\u001b[27Gproperty\u001b[36Gas\u001b[39Ga\u001b[41GTailwind\u001b[50Gutility\u001b[58Gin\u001b[61Gthe\u001b[65Gelement's\u001b[75Gclass\u001b[81Gattribute.\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mCompose\u001b[14Gvariants\u001b[23Gwith\u001b[28Gthe\u001b[32G`cn()`\u001b[39Ghelper\u001b[46G(or\u001b[50Gframework\u001b[60Gequivalent)\u001b[72Gwhen\u001b[77Gclasses\u001b[85Gare\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mconditional.\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211m```tsx\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m//\u001b[9G✓\u001b[11Gcorrect\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m<button\u001b[14GclassName=\"bg-primary\u001b[36Gtext-primary-foreground\u001b[60Grounded-md\u001b[71Gpx-4\u001b[76Gpy-2\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211mhover:bg-primary/90\">\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m \u001b[8GSave\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m</button>\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211m<button\u001b[14GclassName={cn(\"inline-flex\u001b[41Gitems-center\u001b[54Ggap-2\",\u001b[62GisActive\u001b[71G&&\u001b[74G\"ring-2\u001b[82Gring-ring\")}>\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m \u001b[8G{label}\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m</button>\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m```\u001b[39m\r\r\n\r\r\n\u001b[6G\u001b[38;5;211m```tsx\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m//\u001b[9G✗\u001b[11Gwrong\u001b[17G—\u001b[19Gbypasses\u001b[28GTailwind\u001b[39m\r\r\n\u001b[6G\u001b[38;5;211m<button\u001b[14Gstyle={{\u001b[23GbackgroundColor:\u001b[40G\"#2563eb\",\u001b[51Gpadding:\u001