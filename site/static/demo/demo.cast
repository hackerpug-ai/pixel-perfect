\r\n\u001b[10Greturn\u001b[17GresolveCompositions(body,\u001b[43GcatalogRoot,\u001b[56G[...stack,\u001b[67GdepName]).trimEnd();\r\r\n\u001b[8G});\r\r\n\u001b[8G//\u001b[11G---\u001b[15Gcomposed:Name\u001b[29G---\u001b[33G...\u001b[37G---\u001b[41Gend\u001b[45G---\u001b[50G(body\u001b[56Gignored;\u001b[65Glive\u001b[70Gsource\u001b[77Gwins)\r\r\n\u001b[8Gout\u001b[12G=\u001b[14Gout.replace(\r\r\n\u001b[10G/---\\s*composed:([A-Za-z][A-Za-z0-9]*)\\s*---[\\s\\S]*?---\\s*end\\s*---/g,\r\r\n\u001b[10G(_,\u001b[14GdepName)\u001b[23G=>\u001b[26G{\r\r\n\u001b[12Gif\u001b[15G(stack.includes(depName))\u001b[41Greturn\u001b[48G`---\u001b[53Gcomposed:${depName}\u001b[73G---\u001b[77G/*cycle*/\u001b[87G---\r\r\n\u001b[6Gend\u001b[10G---`;\r\r\n\u001b[12Gconst\u001b[18Gbody\u001b[23G=\u001b[25GreadComposee(catalogRoot,\u001b[51GdepName);\r\r\n\u001b[12Gif\u001b[15G(body\u001b[21G==\u001b[24Gnull)\u001b[30Greturn\u001b[37G`---\u001b[42Gcomposed:${depName}\u001b[62G---\u001b[66G/*missing*/\u001b[78G---\u001b[82Gend\u001b[86G---`;\r\r\n\u001b[12Gconst\u001b[18Gresolved\u001b[27G=\u001b[29GresolveCompositions(body,\u001b[55GcatalogRoot,\u001b[68G[...stack,\r\r\n\u001b[6GdepName]).trimEnd();\r\r\n\u001b[12Greturn\u001b[19G`---\u001b[24Gcomposed:${depName}\u001b[44G---\\n${resolved}\\n---\u001b[66Gend\u001b[70G---`;\r\r\n\u001b[10G},\r\r\n\u001b[8G);\r\r\n\u001b[8Greturn\u001b[15Gout;\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6Gfunction\u001b[15GreadComposee(catalogRoot,\u001b[41Gname)\u001b[47G{\r\r\n\u001b[8G//\u001b[11GPrefer\u001b[18Gdefault.txt\u001b[30Gunder\u001b[36Gany\u001b[40Glayer;\u001b[47Gfirst\u001b[53Gmatch\u001b[59Gwins\u001b[64G(atoms\u001b[71Gbefore\u001b[78Gmolecules\u001b[88Gby\r\r\n\u001b[6Gwalk\u001b[11Gorder)\r\r\n\u001b[8Gconst\u001b[14Ghits\u001b[19G=\u001b[21G[];\r\r\n\u001b[8Gfor\u001b[12G(const\u001b[19Gfull\u001b[24Gof\u001b[27GwalkFiles(catalogRoot))\u001b[51G{\r\r\n\u001b[10Gconst\u001b[16Grel\u001b[20G=\u001b[22GrelPosix(catalogRoot,\u001b[44Gfull);\r\r\n\u001b[10Gconst\u001b[16Gparts\u001b[22G=\u001b[24Grel.split(\"/\");\r\r\n\u001b[10Gif\u001b[13G(parts.length\u001b[27G<\u001b[29G3)\u001b[32Gcontinue;\r\r\n\u001b[10Gif\u001b[13G(parts[1]\u001b[23G===\u001b[27Gname\u001b[32G&&\u001b[35Gparts[2].startsWith(\"default.\"))\u001b[68Ghits.push(full);\r\r\n\u001b[8G}\r\r\n\u001b[8Gif\u001b[11G(hits.length\u001b[24G===\u001b[28G0)\u001b[31Greturn\u001b[38Gnull;\r\r\n\u001b[8Greturn\u001b[15GreadFileSync(hits[0],\u001b[37G\"utf8\");\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6G/**\r\r\n\u001b[7G*\u001b[9GBuilt-in\u001b[18Gstructural\u001b[29Gcapture\u001b[37Gfor\u001b[41Gthe\u001b[45Gfixture\u001b[53G/\u001b[55Gtext\u001b[60Gmedium.\r\r\n\u001b[7G*\u001b[9GWalks\u001b[15G`{catalogDir}/{layer}/{name}/{state}.{ext}`\u001b[59Gand\u001b[63Gwrites\u001b[70Gnormalized\r\r\n\u001b[7G*\u001b[9Gartifacts\u001b[19Gto\u001b[22Gstaging\u001b[30Gwith\u001b[35Gthe\u001b[39Gsame\u001b[44Glayout.\u001b[52GComposition\u001b[64Gis\u001b[67Gresolved\u001b[76Glive\u001b[81Gfrom\r\r\n\u001b[7G*\u001b[9G`@compose`\u001b[20G/\u001b[22G`---\u001b[27Gcomposed:Name\u001b[41G---`\u001b[46Gmarkers\u001b[54Gso\u001b[57Gblast/reach\u001b[69Gmeasure\u001b[77Greal\r\r\n\u001b[6Greachability.\r\r\n\u001b[7G*/\r\r\n\u001b[6Gexport\u001b[13Gfunction\u001b[22GcaptureFromCatalog(projectRoot,\u001b[54GcatalogRel,\u001b[66GstagingRel,\u001b[78GlayerFilter\u001b[90G=\r\r\n\u001b[6Gnull)\u001b[12G{\r\r\n\u001b[8Gconst\u001b[14GcatalogRoot\u001b[26G=\u001b[28Gjoin(projectRoot,\u001b[46GcatalogRel);\r\r\n\u001b[8Gif\u001b[11G(!existsSync(catalogRoot))\u001b[38G{\r\r\n\u001b[10Gthrow\u001b[16Gnew\u001b[20GError(`Catalog\u001b[35Gdirectory\u001b[45Gnot\u001b[49Gfound:\u001b[56G${catalogRel}\u001b[70G(under\r\r\n\u001b[6G${projectRoot})`);\r\r\n\u001b[8G}\r\r\n\u001b[8Gconst\u001b[14GstagingRoot\u001b[26G=\u001b[28Gjoin(projectRoot,\u001b[46GstagingRel);\r\r\n\u001b[8G//\u001b[11Gclean\u001b[17Gstaging\u001b[25Gfor\u001b[29Gthis\u001b[34Grun\r\r\n\u001b[8Gif\u001b[11G(existsSync(stagingRoot))\u001b[37GrmSync(stagingRoot,\u001b[57G{\u001b[59Grecursive:\u001b[70Gtrue,\u001b[76Gforce:\u001b[83Gtrue\u001b[88G});\r\r\n\u001b[8GensureDir(stagingRoot);\r\r\n\r\r\n\u001b[8Gconst\u001b[14Gfiles\u001b[20G=\u001b[22GwalkFiles(catalogRoot);\r\r\n\u001b[8Gconst\u001b[14Gstories\u001b[22G=\u001b[24G[];\r\r\n\u001b[8Gfor\u001b[12G(const\u001b[19Gfull\u001b[24Gof\u001b[27Gfiles)\u001b[34G{\r\r\n\u001b[10Gconst\u001b[16Grel\u001b[20G=\u001b[22GrelPosix(catalogRoot,\u001b[44Gfull);\r\r\n\u001b[10Gconst\u001b[16Gparts\u001b[22G=\u001b[24Grel.split(\"/\");\r\r\n\u001b[10G//\u001b[13Gexpect\u001b[20Glayer/name/state.ext\r\r\n\u001b[10Gif\u001b[13G(parts.length\u001b[27G<\u001b[29G3)\u001b[32Gcontinue;\r\r\n\u001b[10Gconst\u001b[16G[layer,\u001b[24Gname,\u001b[30Gfile]\u001b[36G=\u001b[38Gparts;\r\r\n\u001b[10Gif\u001b[13G(layerFilter\u001b[26G&&\u001b[29Glayer\u001b[35G!==\u001b[39GlayerFilter)\u001b[52Gcontinue;\r\r\n\u001b[10Gconst\u001b[16Gdot\u001b[20G=\u001b[22Gfile.lastIndexOf(\".\");\r\r\n\u001b[10Gif\u001b[13G(dot\u001b[18G===\u001b[22G-1)\u001b[26Gcontinue;\r\r\n\u001b[10Gconst\u001b[16Gstate\u001b[22G=\u001b[24Gfile.slice(0,\u001b[38Gdot);\r\r\n\u001b[10Gconst\u001b[16Gext\u001b[20G=\u001b[22Gfile.slice(dot);\r\r\n\u001b[10Gif\u001b[13G(!STRUCTURAL_EXTS.has(ext)\u001b[40G&&\u001b[43Gext\u001b[47G!==\u001b[51G\".png\")\u001b[59Gcontinue;\r\r\n\u001b[10G//\u001b[13Gstructural\u001b[24Ggate\u001b[29Guses\u001b[34Gtext-like\u001b[44Gmedia;\u001b[51Gskip\u001b[56Gbinary\u001b[63Gpng\u001b[67Gfor\u001b[71Gauthoritative\u001b[85Gcompare\r\r\n\u001b[10Gif\u001b[13G(ext\u001b[18G===\u001b[22G\".png\")\u001b[30Gcontinue;\r\r\n\u001b[10Gconst\u001b[16Graw\u001b[20G=\u001b[22GreadFileSync(full,\u001b[41G\"utf8\");\r\r\n\u001b[10Gconst\u001b[16Gcomposed\u001b[25G=\u001b[27GresolveCompositions(raw,\u001b[52GcatalogRoot,\u001b[65G[name]);\r\r\n\u001b[10Gconst\u001b[16Gnormalized\u001b[27G=\u001b[29GnormalizeCapture(composed,\u001b[56GprojectRoot);\r\r\n\u001b[10Gconst\u0