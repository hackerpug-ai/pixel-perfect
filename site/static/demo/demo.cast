r\r\n\u001b[8GargTypes?:\u001b[19G{\u001b[21G[K\u001b[24Gin\u001b[27Gkeyof\u001b[33GP]?:\u001b[38GControl\u001b[46G};\r\r\n\u001b[8G/**\u001b[12GNamed\u001b[18Gstates\u001b[25Gbeyond\u001b[32G`default`,\u001b[43Geach\u001b[48Gan\u001b[51Goverride\u001b[60Gof\u001b[63Gthe\u001b[67Gdefault\u001b[75Gargs.\u001b[81GEvery\u001b[87Gstate\r\r\n\u001b[6Gis\u001b[9Gcaptured.\u001b[19G*/\r\r\n\u001b[8Gstates?:\u001b[17GRecord<string,\u001b[32GPartial<P>>;\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6Gexport\u001b[13Gtype\u001b[18GAnyStory\u001b[27G=\u001b[29GStory<any>;\r\r\n\r\r\n\u001b[6Gexport\u001b[13Gfunction\u001b[22GdefineStory<P\u001b[36Gextends\u001b[44Gobject>(story:\u001b[59GStory<P>):\u001b[70GAnyStory\u001b[79G{\r\r\n\u001b[8Greturn\u001b[15Gstory;\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6Gexport\u001b[13Gfunction\u001b[22GstoryStates(story:\u001b[41GAnyStory):\u001b[52GRecord<string,\u001b[67Gobject>\u001b[75G{\r\r\n\u001b[8Gconst\u001b[14Gstates:\u001b[22GRecord<string,\u001b[37Gobject>\u001b[45G=\u001b[47G{\u001b[49Gdefault:\u001b[58Gstory.args\u001b[69G};\r\r\n\u001b[8Gfor\u001b[12G(const\u001b[19G[name,\u001b[26Goverrides]\u001b[37Gof\u001b[40GObject.entries(story.states\u001b[68G??\u001b[71G{}))\u001b[76G{\r\r\n\u001b[10Gstates[name]\u001b[23G=\u001b[25G{\u001b[27G...story.args,\u001b[42G...overrides\u001b[55G};\r\r\n\u001b[8G}\r\r\n\u001b[8Greturn\u001b[15Gstates;\r\r\n\u001b[6G}\r\r\n\u001b[6G===\u001b[10Gsandbox/stories/Icons.stories.tsx\r\r\n\u001b[6G//\u001b[9GTarget:\u001b[17Gmockups/pricing.html\u001b[38G—\u001b[40Gthe\u001b[44Gdesign's\u001b[53Gonly\u001b[58Gglyph\u001b[64Gis\u001b[67Gthe\u001b[71Gfeature\u001b[79Gcheck\u001b[85Gmark.\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GCheck,\u001b[22Gtype\u001b[27GLucideIcon\u001b[38G}\u001b[40Gfrom\u001b[45G\"lucide-react\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GIcon,\u001b[21Gtype\u001b[26GIconSize\u001b[35G}\u001b[37Gfrom\u001b[42G\"../../src/components/Icon\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GdefineStory\u001b[27G}\u001b[29Gfrom\u001b[34G\"../story\";\r\r\n\r\r\n\u001b[6Gconst\u001b[12GICONS:\u001b[19G{\u001b[21Gname:\u001b[27Gstring;\u001b[35Gicon:\u001b[41GLucideIcon;\u001b[53Gusage:\u001b[60Gstring\u001b[67G}[]\u001b[71G=\u001b[73G[\r\r\n\u001b[8G{\u001b[10Gname:\u001b[16G\"check\",\u001b[25Gicon:\u001b[31GCheck,\u001b[38Gusage:\u001b[45G\"Feature\u001b[54Glist\u001b[59Gcheck\u001b[65Gmark\"\u001b[71G},\r\r\n\u001b[6G];\r\r\n\r\r\n\u001b[6Gconst\u001b[12GSIZES:\u001b[19G{\u001b[21Gsize:\u001b[27GIconSize;\u001b[37Gvalue:\u001b[44Gstring\u001b[51G}[]\u001b[55G=\u001b[57G[\r\r\n\u001b[8G{\u001b[10Gsize:\u001b[16G\"sm\",\u001b[22Gvalue:\u001b[29G\"16px\"\u001b[36G},\r\r\n\u001b[8G{\u001b[10Gsize:\u001b[16G\"md\",\u001b[22Gvalue:\u001b[29G\"20px\"\u001b[36G},\r\r\n\u001b[8G{\u001b[10Gsize:\u001b[16G\"lg\",\u001b[22Gvalue:\u001b[29G\"24px\"\u001b[36G},\r\r\n\u001b[8G{\u001b[10Gsize:\u001b[16G\"xl\",\u001b[22Gvalue:\u001b[29G\"32px\"\u001b[36G},\r\r\n\u001b[6G];\r\r\n\r\r\n\u001b[6Gfunction\u001b[15GIcons()\u001b[23G{\r\r\n\u001b[8Greturn\u001b[15G(\r\r\n\u001b[10G<ul\u001b[14GclassName=\"grid\u001b[30Ggap-6\">\r\r\n\u001b[12G{ICONS.map(({\u001b[26Gname,\u001b[32Gicon,\u001b[38Gusage\u001b[44G})\u001b[47G=>\u001b[50G(\r\r\n\u001b[14G<li\u001b[18Gkey={name}\u001b[29GclassName=\"flex\u001b[45Gitems-end\u001b[55Ggap-12\">\r\r\n\u001b[16G<div\u001b[21GclassName=\"w-60\">\r\r\n\u001b[18G<div\u001b[23GclassName=\"text-caption\">{name}</div>\r\r\n\u001b[18G<div\u001b[23GclassName=\"text-tag\u001b[43Gfont-mono\u001b[53Gtext-muted-foreground\">{usage}</div>\r\r\n\u001b[16G</div>\r\r\n\u001b[16G{SIZES.map(({\u001b[30Gsize,\u001b[36Gvalue\u001b[42G})\u001b[45G=>\u001b[48G(\r\r\n\u001b[18G<div\u001b[23Gkey={size}\u001b[34GclassName=\"grid\u001b[50Gjustify-items-center\u001b[71Ggap-2\">\r\r\n\u001b[20G<Icon\u001b[26Gicon={icon}\u001b[38Gsize={size}\u001b[50G/>\r\r\n\u001b[20G<div\u001b[25GclassName=\"text-tag\u001b[45Gfont-mono\u001b[55Gtext-muted-foreground\">\r\r\n\u001b[22G{size}\u001b[29G·\u001b[31G{value}\r\r\n\u001b[20G</div>\r\r\n\u001b[18G</div>\r\r\n\u001b[16G))}\r\r\n\u001b[14G</li>\r\r\n\u001b[12G))}\r\r\n\u001b[10G</ul>\r\r\n\u001b[8G);\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6Gexport\u001b[13Gdefault\u001b[21GdefineStory({\r\r\n\u001b[8Glayer:\u001b[15G\"tokens\",\r\r\n\u001b[8Gname:\u001b[14G\"Icons\",\r\r\n\u001b[8Gtarget:\u001b[16G\"mockups/pricing.html\",\r\r\n\u001b[8Grender:\u001b[16G()\u001b[19G=>\u001b[22G<Icons\u001b[29G/>,\r\r\n\u001b[8Gargs:\u001b[14G{},\r\r\n\u001b[6G});\r\r\n\u001b[6G===\u001b[10Gsandbox/capture.mjs\r\r\n\u001b[6G//\u001b[9Gsandbox/capture.mjs\u001b[29G—\u001b[31Gcatalog\u001b[39Gcapture.\u001b[48GWalks\u001b[54Gthe\u001b[58Gregistry\u001b[67Gheadless\u001b[76Gand\u001b[80Gwrites,\u001b[88Gper\r\r\n\u001b[6Gstory\u001b[12Gstate:\r\r\n\u001b[6G//\u001b[11G{out}/{layer}/{name}/{state}.txt\u001b[46Gnormalized\u001b[57GDOM\u001b[61G—\u001b[63Gthe\u001b[67Gstructural\u001b[78Gartifact\u001b[87Gthe\r\r\n\u001b[6Gcatalog\u001b[14Ggate\u001b[19Gdiffs\r\r\n\u001b[6G//\u001b[11G{out}/{layer}/{name}/{state}.png\u001b[46Gscreenshot\u001b[57Gvia\u001b[61Gheadless\u001b[70GChrome\u001b[77G—\u001b[79Greview\u001b[86Gonly,\r\r\n\u001b[6Gskipped\u001b[14Gif\u001b[17GChrome\u001b[24Gis\u001b[27Gabsent\r\r\n\u001b[6G//\u001b[9GUsage:\u001b[16Gnode\u001b[21Gsandbox/capture.mjs\u001b[41G[--no-png]\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15Gspawn\u001b[21G}\u001b[23Gfrom\u001b[28G\"node:child_process\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GexistsSync,\u001b[27GmkdirSync,\u001b[38GmkdtempSync,\u001b[51GrmSync,\u001b[59GstatSync,\u001b[69GwriteFileSync\u001b[83G}\u001b[85Gfrom\r\r\n\u001b[6G\"node:fs\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15Gtmpdir\u001b[22G}\u001b[24Gfrom\u001b[29G\"node:os\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15Gdirname,\u001b[24Gjoin\u001b[29G}\u001b[31Gfrom\u001b[36G\"node:path\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GfileURLToPath\u001b[29G}\u001b[31Gfrom\u001b[36G\"node:url\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GrenderToStaticMarkup\u001b[36G}\u001b[38Gfrom\u001b[43G\"react-dom/server\";\r\r\n\u001b[6Gimport\u001b[13G{\u001b[15GcreateServer\u001b[28G}\u001b[30Gfrom\u001b[35G\"vite\";\r\r\n\r\r\n\u001b[6Gconst\u001b[12Gsandbox\u001b[20G=\u001b[22Gdirname(fileURLToPath(import.meta.url));\r\r\n\u001b[6Gconst\u001b[12Gproject\u001b[20G=\u001b[22Gjoin(sandbox,\u001b[36G\"..\");\r\r\n\u001b[6Gconst\u001b[12Gout\u001b[16G=\u001b[18Gprocess.env.PIXEL_PERFECT_CAPTURE_OUT\u001b[56G||\u001b[59Gjoin(project,\r\r\n\u001b[6G\"design/.captures/web-desktop\");\r\r\n\u001b[6Gconst\u001b[12GVIEWPORT\u001b[21G=\u001b[23G[1440,\u001b[30G900];\r\r\n\r\r\n\u001b[6Gfunction\u001b[15GfindChrome()\u001b[28G{\r\r\n\u001b[8Gif\u001b[11G(process.argv.includes(\"--no-png\"))\u001b[47Greturn\u001b[54Gnull;\r\r\n\u001b[8Gconst\u001b[14Gcandidates\u001b[25G=\u001b[27G[\r\r\n\u001b[10Gprocess.env.CHROME,\r\r\n\u001b[10G\"/Applications/Google\u001b[32GChrome.app/Contents/MacOS/Google\u001b[65GChrome\",\r\r\n\u001b[10G\"/Applications/Chromium.app/Contents/MacOS/Chromium\",\r\r\n\u001b[10G\"/usr/bin/google-chrome\",\r\r\n\u001b[10G\"/usr/bin/google-chrome-stable\",\r\r\n\u001b[10G\"/usr/bin/chromium\",\r\r\n\u001b[10G\"/usr/bin/chromium-browser\",\r\r\n\u001b[8G];\r\r\n\u001b[8Greturn\u001b[15Gcandidates.find((path)\u001b[38G=>\u001b[41Gpath\u001b[46G&&\u001b[49GexistsSync(path))\u001b[67G??\u001b[70Gnull;\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6G//\u001b[9GAsync\u001b[15Gon\u001b[18Gpurpose:\u001b[27Gthe\u001b[31GVite\u001b[36Gserver\u001b[43GChrome\u001b[50Gloads\u001b[56Gfrom\u001b[61Gruns\u001b[66Gin\u001b[69Gthis\u001b[74Gprocess,\u001b[83Gso\u001b[86Ga\r\r\n\u001b[6Gblocking\u001b[15Gspawn\u001b[21Gwould\u001b[27Gstarve\u001b[34Git.\r\r\n\u001b[6G//\u001b[9GHeadless\u001b[18GChrome\u001b[25Gcan\u001b[29Glinger\u001b[36Gafter\u001b[42Gwriting\u001b[50Gthe\u001b[54Gscreenshot,\u001b[66Gso\u001b[69Gthe\u001b[73Gfile\u001b[78Glanding\u001b[86Gis\u001b[89Gthe\r\r\n\u001b[6Gsignal,\u001b[14Gnot\u001b[18Gthe\u001b[22Gexit.\r\r\n\u001b[6Gfunction\u001b[15Gscreenshot(chrome,\u001b[34Gprofile,\u001b[43Gurl,\u001b[48Gpng)\u001b[53G{\r\r\n\u001b[8Greturn\u001b[15Gnew\u001b[19GPromise((resolve)\u001b[37G=>\u001b[40G{\r\r\n\u001b[10Gconst\u001b[16Gchild\u001b[22G=\u001b[24Gspawn(\r\r\n\u001b[12Gchrome,\r\r\n\u001b[12G[\r\r\n\u001b[14G\"--headless=new\",\r\r\n\u001b[14G\"--disable-gpu\",\r\r\n\u001b[14G\"--no-first-run\",\r\r\n\u001b[14G\"--hide-scrollbars\",\r\r\n\u001b[14G\"--force-prefers-reduced-motion\",\r\r\n\u001b[14G`--user-data-dir=${profile}`,\r\r\n\u001b[14G`--window-size=${VIEWPORT.join(\",\")}`,\r\r\n\u001b[14G\"--virtual-time-budget=5000\",\r\r\n\u001b[14G`--screenshot=${png}`,\r\r\n\u001b[14Gurl,\r\r\n\u001b[12G],\r\r\n\u001b[12G{\u001b[14Gstdio:\u001b[21G\"ignore\"\u001b[30G},\r\r\n\u001b[10G);\r\r\n\u001b[10Gconst\u001b[16Gstarted\u001b[24G=\u001b[26GDate.now();\r\r\n\u001b[10Glet\u001b[14Gsize\u001b[19G=\u001b[21G-1;\r\r\n\u001b[10Gconst\u001b[16Gpoll\u001b[21G=\u001b[23GsetInterval(()\u001b[38G=>\u001b[41G{\r\r\n\u001b[12Gconst\u001b[18Gnow\u001b[22G=\u001b[24GexistsSync(png)\u001b[40G?\u001b[42GstatSync(png).size\u001b[61G:\u001b[63G-1;\r\r\n\u001b[12Gconst\u001b[18Gsettled\u001b[26G=\u001b[28Gnow\u001b[32G>\u001b[34G0\u001b[36G&&\u001b[39Gnow\u001b[43G===\u001b[47Gsize;\r\r\n\u001b[12Gsize\u001b[17G=\u001b[19Gnow;\r\r\n\u001b[12Gif\u001b[15G(settled\u001b[24G||\u001b[27GDate.now()\u001b[38G-\u001b[40Gstarted\u001b[48G>\u001b[50G30_000)\u001b[58Gchild.kill(\"SIGKILL\");\r\r\n\u001b[10G},\u001b[13G250);\r\r\n\u001b[10Gconst\u001b[16Gdone\u001b[21G=\u001b[23G()\u001b[26G=>\u001b[29G{\r\r\n\u001b[12GclearInterval(poll);\r\r\n\u001b[12Gresolve(existsSync(png)\u001b[36G&&\u001b[39GstatSync(png).size\u001b[58G>\u001b[60G0);\r\r\n\u001b[10G};\r\r\n\u001b[10Gchild.on(\"exit\",\u001b[27Gdone);\r\r\n\u001b[10Gchild.on(\"error\",\u001b[28Gdone);\r\r\n\u001b[8G});\r\r\n\u001b[6G}\r\r\n\r\r\n\u001b[6G//\u001b[9GOne\u001b[13Gelement\u001b[21Gper\u001b[25Gline\u