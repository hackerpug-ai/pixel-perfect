    "local_read": ["Read", "Grep", "Glob", "LS", "NotebookRead", "ToolSearch", "ListAgents", "Skill"],
    "expensive": ["Task", "Workflow", "WebFetch", "WebSearch", "Bash", "Write", "Edit", "NotebookEdit", "Monitor", "ScheduleWakeup", "SendMessage", "Skill"],
    "image_judge": []
  },
  "provenance": {
